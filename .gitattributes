# Satır sonu normalizasyonu: depoda daima LF, Windows'ta çalışma kopyası CRLF olabilir.
* text=auto eol=lf

# Windows'a özgü betikler CRLF kalmalı.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Kaynak kod ve yapılandırma
*.dart text
*.yaml text
*.yml text
*.json text
*.js text
*.md text
*.xml text
*.kts text
*.gradle text
*.properties text
*.swift text
*.h text
*.m text
*.plist text
*.txt text
*.rules text
gradlew text eol=lf

# İkili dosyalar asla dönüştürülmemeli.
